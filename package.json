{
  "name": "archipelago-controller",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "description": "A desktop session builder and host controller for Archipelago.",
  "author": "Archipelago Controller contributors",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && node scripts/run-electron.cjs . --dev\"",
    "build": "tsc -b && vite build",
    "package": "npm run build && electron-builder --dir",
    "release": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "release:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/run-icon-builder.cjs",
    "desktop": "node scripts/run-electron.cjs ."
  },
  "dependencies": {
    "@achingbrain/nat-port-mapper": "^4.0.5",
    "@vitejs/plugin-react": "latest",
    "default-gateway": "^7.2.2",
    "fflate": "^0.8.3",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "yaml": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "io.archipelago.controller",
    "productName": "Archipelago Controller",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/caddy",
        "to": "caddy",
        "filter": [
          "caddy.exe",
          "LICENSE*"
        ]
      }
    ],
    "protocols": [
      {
        "name": "Archipelago Controller Room",
        "schemes": [
          "archipelago-controller"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Archipelago Controller"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    }
  }
}
